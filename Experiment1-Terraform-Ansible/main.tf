# Student: Kartik Kumar | Roll: 2301730205 | Email: kartikjangra5366@gmail.com
# =============================================================================

terraform {
  required_version = ">= 1.0.0"
  required_providers {
    local = {
      source  = "hashicorp/local"
      version = "~> 2.4"
    }
    null = {
      source  = "hashicorp/null"
      version = "~> 3.2"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.5"
    }
  }
}

# =============================================================================
# Variables
# =============================================================================

variable "project_name" {
  description = "Name of the project"
  type        = string
  default     = "devops-lab3-kartik"
}

variable "student_name" {
  description = "Student name"
  type        = string
  default     = "Kartik Kumar"
}

variable "roll_number" {
  description = "Student roll number"
  type        = string
  default     = "2301730205"
}

variable "environment" {
  description = "Deployment environment"
  type        = string
  default     = "development"
  validation {
    condition     = contains(["development", "staging", "production"], var.environment)
    error_message = "Environment must be development, staging, or production."
  }
}

variable "app_port" {
  description = "Application port"
  type        = number
  default     = 8080
}

variable "replica_count" {
  description = "Number of application replicas"
  type        = number
  default     = 2
}

# =============================================================================
# Random ID for unique naming
# =============================================================================

resource "random_id" "deployment_id" {
  byte_length = 4
}

# =============================================================================
# Local Resources - Infrastructure Directory Structure
# =============================================================================

resource "local_file" "infrastructure_config" {
  filename = "${path.module}/output/infrastructure.json"
  content = jsonencode({
    project     = var.project_name
    student     = var.student_name
    roll_number = var.roll_number
    environment = var.environment
    deployment_id = random_id.deployment_id.hex
    timestamp   = timestamp()
    servers = {
      web_servers = [
        for i in range(var.replica_count) : {
          name    = "web-server-${i + 1}-${random_id.deployment_id.hex}"
          ip      = "10.0.${i + 1}.10"
          port    = var.app_port
          role    = "web"
          status  = "provisioned"
        }
      ]
      db_server = {
        name   = "db-server-${random_id.deployment_id.hex}"
        ip     = "10.0.10.10"
        port   = 5432
        role   = "database"
        status = "provisioned"
      }
      monitoring_server = {
        name   = "monitoring-${random_id.deployment_id.hex}"
        ip     = "10.0.20.10"
        port   = 9090
        role   = "monitoring"
        status = "provisioned"
      }
    }
    network = {
      vpc_cidr    = "10.0.0.0/16"
      subnet_cidr = "10.0.0.0/24"
      region      = "ap-south-1"
    }
    tags = {
      Project     = var.project_name
      Environment = var.environment
      ManagedBy   = "Terraform"
      Student     = var.student_name
      RollNumber  = var.roll_number
    }
  })
  directory_permission = "0755"
  file_permission      = "0644"
}

resource "local_file" "ansible_inventory" {
  filename = "${path.module}/output/ansible_inventory.ini"
  content  = <<-EOT
    # Ansible Inventory - Generated by Terraform
    # Student: ${var.student_name} | Roll: ${var.roll_number}
    # Deployment ID: ${random_id.deployment_id.hex}
    # Generated: ${timestamp()}

    [webservers]
    %{for i in range(var.replica_count)}
    web-server-${i + 1} ansible_host=10.0.${i + 1}.10 ansible_user=ubuntu ansible_port=22
    %{endfor}

    [databases]
    db-server ansible_host=10.0.10.10 ansible_user=ubuntu ansible_port=22

    [monitoring]
    monitoring ansible_host=10.0.20.10 ansible_user=ubuntu ansible_port=22

    [all:vars]
    ansible_python_interpreter=/usr/bin/python3
    project_name=${var.project_name}
    environment=${var.environment}
    app_port=${var.app_port}
    student_name=${var.student_name}
    roll_number=${var.roll_number}
  EOT
  directory_permission = "0755"
  file_permission      = "0644"
}

resource "local_file" "env_config" {
  filename = "${path.module}/output/.env"
  content  = <<-EOT
    # Environment Configuration - Generated by Terraform
    # Project: ${var.project_name}
    # Student: ${var.student_name}
    PROJECT_NAME=${var.project_name}
    ENVIRONMENT=${var.environment}
    APP_PORT=${var.app_port}
    REPLICA_COUNT=${var.replica_count}
    DEPLOYMENT_ID=${random_id.deployment_id.hex}
    DB_HOST=10.0.10.10
    DB_PORT=5432
    DB_NAME=devopslab3_db
    PROMETHEUS_PORT=9090
    GRAFANA_PORT=3000
    ELASTICSEARCH_PORT=9200
    KIBANA_PORT=5601
    LOGSTASH_PORT=5044
  EOT
  directory_permission = "0755"
  file_permission      = "0644"
}

resource "local_file" "terraform_outputs" {
  filename = "${path.module}/output/terraform_summary.txt"
  content  = <<-EOT
    ========================================================
    TERRAFORM PROVISIONING SUMMARY
    ========================================================
    Project Name   : ${var.project_name}
    Student        : ${var.student_name}
    Roll Number    : ${var.roll_number}
    Environment    : ${var.environment}
    Deployment ID  : ${random_id.deployment_id.hex}
    ========================================================

    INFRASTRUCTURE PROVISIONED:
    ---------------------------
    Web Servers    : ${var.replica_count} instances
    DB Server      : 1 instance (PostgreSQL)
    Monitoring     : 1 instance (Prometheus + Grafana)

    NETWORK CONFIG:
    ---------------
    VPC CIDR       : 10.0.0.0/16
    App Port       : ${var.app_port}
    Region         : ap-south-1 (Mumbai)

    RESOURCES CREATED:
    ------------------
    - Infrastructure JSON config
    - Ansible inventory file
    - Environment variables file
    - Docker Compose configuration
    - Nginx load balancer config

    STATUS: PROVISIONED SUCCESSFULLY
    ========================================================
  EOT
  directory_permission = "0755"
  file_permission      = "0644"
}

resource "local_file" "docker_compose" {
  filename = "${path.module}/output/docker-compose.yml"
  content  = <<-EOT
    # Docker Compose - Generated by Terraform
    # Project: ${var.project_name} | Env: ${var.environment}
    version: '3.8'

    networks:
      devops_network:
        driver: bridge
        ipam:
          config:
            - subnet: 172.20.0.0/24

    volumes:
      postgres_data:
      prometheus_data:
      grafana_data:

    services:
      # Web Application
      webapp:
        image: nginx:alpine
        container_name: ${var.project_name}-webapp
        ports:
          - "${var.app_port}:80"
        networks:
          devops_network:
            ipv4_address: 172.20.0.10
        environment:
          - ENVIRONMENT=${var.environment}
          - PROJECT=${var.project_name}
        restart: unless-stopped
        labels:
          - "project=${var.project_name}"
          - "student=${var.student_name}"
          - "roll=${var.roll_number}"

      # PostgreSQL Database
      database:
        image: postgres:15-alpine
        container_name: ${var.project_name}-db
        environment:
          POSTGRES_DB: devopslab3_db
          POSTGRES_USER: devops_user
          POSTGRES_PASSWORD: DevOps@2024
        volumes:
          - postgres_data:/var/lib/postgresql/data
        networks:
          devops_network:
            ipv4_address: 172.20.0.20
        restart: unless-stopped

      # Prometheus Monitoring
      prometheus:
        image: prom/prometheus:latest
        container_name: ${var.project_name}-prometheus
        ports:
          - "9090:9090"
        networks:
          devops_network:
            ipv4_address: 172.20.0.30
        restart: unless-stopped

      # Grafana Dashboard
      grafana:
        image: grafana/grafana:latest
        container_name: ${var.project_name}-grafana
        ports:
          - "3000:3000"
        environment:
          - GF_SECURITY_ADMIN_PASSWORD=admin123
        networks:
          devops_network:
            ipv4_address: 172.20.0.40
        restart: unless-stopped
  EOT
  directory_permission = "0755"
  file_permission      = "0644"
}

# =============================================================================
# Null Resources - Simulated Provisioning Steps
# =============================================================================

resource "null_resource" "infrastructure_validation" {
  triggers = {
    config_hash = local_file.infrastructure_config.id
    env_hash    = local_file.env_config.id
  }

  provisioner "local-exec" {
    command = "echo 'Infrastructure validation complete for ${var.project_name}'"
  }
}

# =============================================================================
# Outputs
# =============================================================================

output "project_info" {
  description = "Project information"
  value = {
    name        = var.project_name
    student     = var.student_name
    roll_number = var.roll_number
    environment = var.environment
  }
}

output "deployment_id" {
  description = "Unique deployment identifier"
  value       = random_id.deployment_id.hex
}

output "infrastructure_config_path" {
  description = "Path to infrastructure configuration"
  value       = local_file.infrastructure_config.filename
}

output "ansible_inventory_path" {
  description = "Path to Ansible inventory"
  value       = local_file.ansible_inventory.filename
}

output "web_server_ips" {
  description = "Web server IP addresses"
  value       = [for i in range(var.replica_count) : "10.0.${i + 1}.10"]
}

output "monitoring_endpoint" {
  description = "Monitoring server endpoint"
  value       = "http://10.0.20.10:9090"
}

output "app_endpoint" {
  description = "Application endpoint"
  value       = "http://localhost:${var.app_port}"
}

